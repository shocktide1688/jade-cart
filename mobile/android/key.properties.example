# 发布签名配置模板 (复制为 key.properties 后填写)
#
#   cp key.properties.example key.properties
#
# key.properties 与 .jks/.keystore 都不要提交到 Git (已在 .gitignore 中)
# 生成 keystore:
#   keytool -genkey -v -keystore ~/keystores/jade-cart-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias jade-cart
#
storeFile=/Users/<你的用户名>/keystores/jade-cart-release.jks
storePassword=在此填入 keystore 密码
keyAlias=jade-cart
keyPassword=在此填入 key 密码
